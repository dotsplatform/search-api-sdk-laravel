{
    "name": "dotsplatform/search-api-sdk",
    "type": "library",
    "description": "SDK for the Dots search service: item search index ingest and querying.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dotsplatform\\SearchApiSdk\\": "src/App"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Bogdan Mamontov",
            "email": "bohdan.mamontov@dotsplatform.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "*",
        "dotsplatform/utils": "^1.|^2.",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.",
        "eduarguz/shift-php-cs": "^3.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "scripts": {
        "init-pre-commit": [
            "cp .git-hooks-pre-commit .git/hooks/pre-commit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dotsplatform\\SearchApiSdk\\SearchAppServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
